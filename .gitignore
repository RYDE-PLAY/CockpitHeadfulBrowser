# Please keep this file sorted (LC_COLLATE=C.UTF-8),
# grouped into the 3 categories below:
#  - general patterns (match in all directories)
#  - patterns to match files at the toplevel
#  - patterns to match files in subdirs

# general patterns
*.key
*.log
*.pem
*.pyc
*.rpm
__pycache__/
.coverage
.mypy_cache/
.ruff_cache/

# local credentials and environment files
.env
.env.*
!.env.example

# editor and operating-system files
.DS_Store
.idea/
.vscode/

# toplevel (/...)
/Test*.html
/Test*.json
/Test*.log
/Test*.log.gz
/Test*.png
/*.whl
/bots
/cockpit-*.spec
/cockpit-*.tar.xz
/cockpit-navigator.spec
/dist/
/metafile.json
/.dev-data/
/.dev-config/
/artifacts/
/.cache/
/.pytest_cache/
/.playwright/
/*.deb
/*.deb.sha256
/playwright-report/
/test-results/
/pkg/
/node_modules/
/runtime-npm-modules.txt
/tmp/
/tools/

# subdirs (/subdir/...)
/packaging/arch/PKGBUILD
/packaging/debian/changelog
/po/*.pot
/po/LINGUAS
/test/common/
/test/images/
/test/static-code

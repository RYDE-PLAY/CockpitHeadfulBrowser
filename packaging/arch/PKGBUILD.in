pkgname=cockpit-browser
pkgver=VERSION
pkgrel=1
pkgdesc='Cockpit module for an interactive browser session'
arch=('x86_64')
url='https://github.com/RYDE-PLAY/CockpitHeadfulBrowser'
license=(LGPL)
source=("SOURCE")
sha256sums=('SKIP')

package() {
  depends=(cockpit)
  cd $pkgname
  make DESTDIR="$pkgdir" install PREFIX=/usr
}
